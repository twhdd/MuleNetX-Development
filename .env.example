# MuleNetX configuration (SRS §23.2). Copy to `.env` and fill every secret.
# Startup fails on a missing required value or a known default secret (SR-15).

# ── Infrastructure and secrets ───────────────────────────────────────────────
# Superuser password of the postgres container (used only by the init script).
POSTGRES_SUPERUSER_PASSWORD=
# Passwords of the two database roles created by docker/postgres/init.sql (§6.5).
MULENETX_OWNER_PASSWORD=
MULENETX_APP_PASSWORD=
# Application DSN (role mulenetx_app; used by backend and worker).
POSTGRES_DSN=postgresql+psycopg://mulenetx_app:CHANGE_ME@postgres:5432/mulenetx
# Owner DSN (role mulenetx_owner; used only by the migrate service) [PLAN DEFAULT §3.7].
POSTGRES_OWNER_DSN=postgresql+psycopg://mulenetx_owner:CHANGE_ME@postgres:5432/mulenetx
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# `neo4j` (the image default) is rejected at startup.
NEO4J_PASSWORD=
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
MULENETX_BOOTSTRAP_ADMIN_USERNAME=admin
MULENETX_BOOTSTRAP_ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:8080
ARTIFACT_DIR=/data/artifacts
STAGING_DIR=/data/staging
LOG_LEVEL=INFO

# ── Authentication ───────────────────────────────────────────────────────────
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
# Argon2id parameters (library defaults, recorded).
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4

# ── Ingestion, jobs, snapshots ───────────────────────────────────────────────
MAX_UPLOAD_BYTES=1073741824
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=15
JOB_MAX_ATTEMPTS=3
# Per-kind wall-clock limits [PLAN DEFAULT T07].
JOB_TIMEOUT_INGEST_SECONDS=3600
JOB_TIMEOUT_PIPELINE_STAGE_SECONDS=7200
JOB_TIMEOUT_TRAIN_SECONDS=7200
JOB_TIMEOUT_INTERVENTION_SECONDS=1800
JOB_TIMEOUT_EVALUATION_SECONDS=3600
JOB_TIMEOUT_SNAPSHOT_RETIRE_SECONDS=1800
GRAPH_BUILD_BATCH_SIZE=10000
SYNTHETIC_INJECTION_ENABLED=false
WORKER_PIPELINE_SLOTS=1
WORKER_ANALYSIS_SLOTS=2

# ── Versioned analytical parameters (V) ──────────────────────────────────────
# Read only when a new version record is created and copied into it (§23.1).
REFERENCE_SLICE_MAX_ROWS=1000000
PAYSIM_EPOCH_ANCHOR=2020-01-01T00:00:00Z
ANALYTICS_ENGINE=REFERENCE
PAGERANK_DAMPING=0.85
PAGERANK_MAX_ITERATIONS=100
PAGERANK_TOLERANCE=0.000001
LOUVAIN_RESOLUTION=1.0
LOUVAIN_SEED=42
MIN_CANDIDATE_COMMUNITY_SIZE=3
MFC_TOP_K=3
SUSPICIOUS_THRESHOLD=0.50
PROPAGATION_MAXIMUM_DISTANCE=3
PROPAGATION_MAXIMUM_CONTRIBUTION=0.50
PROPAGATION_PROVENANCE_TOP_N=5
MOTIF_MAX_EXPANSIONS_PER_ANCHOR=100000
ANALYTIC_MAX_DEPTH=5
ANALYTIC_MAX_PATHS=10000
ANALYTIC_MAX_EXPANSIONS=1000000
K_MAX=3
INTERVENTION_MAX_CANDIDATES=5000

# ── Money flow, interventions, API ───────────────────────────────────────────
PATH_MAX_DEPTH=5
PATH_MAX_RESULTS=50
PATH_QUERY_TIMEOUT_SECONDS=5
MAX_HOP_EVIDENCE=20
MAX_CONCURRENT_SCENARIOS_PER_USER=2
GRAPH_MAX_DEPTH=3
GRAPH_MAX_NODES=500
GRAPH_MAX_EDGES=2000
GRAPH_QUERY_TIMEOUT_SECONDS=5
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
PAGINATION_COUNT_CAP=10000
MAX_TRANSACTION_RANGE_DAYS=31

# ── Copilot ──────────────────────────────────────────────────────────────────
COPILOT_TIMEOUT_SECONDS=20
COPILOT_MAX_CONCURRENCY=1
COPILOT_RATE_PER_MINUTE=6
COPILOT_MAX_CONTEXT_TOKENS=6000
COPILOT_MAX_TEXT_FIELD=1000
COPILOT_MAX_OUTPUT_TOKENS=1024
COPILOT_DENY_LIST_VERSION=1
