{
  "feature_version": "v1",
  "registry_format": 1,
  "source": "SRS v1.3.3 §10.1",
  "conventions": {
    "epsilon": 1e-09,
    "window_semantics": "half-open (T - w, T]",
    "ordering": "(timestamp, transaction_id)",
    "hour_buckets": "UTC-aligned",
    "states": {
      "OBSERVED": 0,
      "ZERO": 1,
      "UNAVAILABLE": 2,
      "NOT_APPLICABLE": 3
    },
    "missing_encoding": "IEEE NaN for UNAVAILABLE and NOT_APPLICABLE"
  },
  "parameters": {
    "rapid_follow_seconds": 3600,
    "short_interval_seconds": 3600,
    "burst_buckets": 168,
    "dormancy_recent_seconds": 86400,
    "dormancy_prior_seconds": 2678400,
    "dormancy_prior_days": 30,
    "dormancy_min_active_days": 7,
    "cycle_min_hops": 2,
    "cycle_max_hops": 5,
    "cycle_max_span_seconds": 86400,
    "inactivity_gap_seconds": 86400,
    "short_lived_max_seconds": 259200,
    "outgoing_path_max_depth": 5,
    "suspicious_hops": 3
  },
  "features": [
    {
      "id": "F01",
      "name": "transaction_count",
      "definition": "count of transactions, any direction",
      "window": "lifetime ≤ T",
      "window_seconds": null,
      "unavailable_when": "never",
      "cold_start": "0 (ZERO)",
      "description": "Number of transactions in which the account is source or destination.",
      "datatype": "int64",
      "unit": "count",
      "direction": "any",
      "cap": null,
      "leakage_risk": "low: uses no label",
      "group": "transactional"
    },
    {
      "id": "F02",
      "name": "incoming_transaction_count",
      "definition": "count with destination = account",
      "window": "lifetime",
      "window_seconds": null,
      "unavailable_when": "never",
      "cold_start": "0 (ZERO)",
      "description": "Number of incoming transactions.",
      "datatype": "int64",
      "unit": "count",
      "direction": "in",
      "cap": null,
      "leakage_risk": "low",
      "group": "transactional"
    },
    {
      "id": "F03",
      "name": "outgoing_transaction_count",
      "definition": "count with source = account",
      "window": "lifetime",
      "window_seconds": null,
      "unavailable_when": "never",
      "cold_start": "0 (ZERO)",
      "description": "Number of outgoing transactions.",
      "datatype": "int64",
      "unit": "count",
      "direction": "out",
      "cap": null,
      "leakage_risk": "low",
      "group": "transactional"
    },
    {
      "id": "F04",
      "name": "incoming_amount",
