      "window": "lifetime",
      "window_seconds": null,
      "unavailable_when": "never",
      "cold_start": "0 (ZERO)",
      "description": "Total amount received.",
      "datatype": "float64",
      "unit": "currency",
      "direction": "in",
      "cap": null,
      "leakage_risk": "low",
      "group": "transactional"
    },
    {
      "id": "F05",
      "name": "outgoing_amount",
      "definition": "sum of outgoing amounts",
      "window": "lifetime",
      "window_seconds": null,
      "unavailable_when": "never",
      "cold_start": "0 (ZERO)",
      "description": "Total amount sent.",
      "datatype": "float64",
      "unit": "currency",
      "direction": "out",
      "cap": null,
      "leakage_risk": "low",
      "group": "transactional"
    },
    {
      "id": "F06",
      "name": "mean_transaction_amount",
      "definition": "mean amount, any direction",
      "window": "lifetime",
      "window_seconds": null,
      "unavailable_when": "never",
      "cold_start": "0 (ZERO)",
