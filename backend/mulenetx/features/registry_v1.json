      "datatype": "float64",
      "unit": "currency",
      "direction": "any",
      "cap": null,
      "leakage_risk": "low",
      "group": "transactional"
    },
    {
      "id": "F07",
      "name": "median_transaction_amount",
      "definition": "median amount, any direction (mean of the two middle values for even n)",
      "window": "lifetime",
      "window_seconds": null,
      "unavailable_when": "never",
      "cold_start": "0 (ZERO)",
      "description": "Median transaction amount.",
      "datatype": "float64",
      "unit": "currency",
      "direction": "any",
      "cap": null,
      "leakage_risk": "low",
      "group": "transactional"
    },
    {
      "id": "F08",
      "name": "amount_stddev",
      "definition": "sample standard deviation; 0 if fewer than 2",
      "window": "lifetime",
      "window_seconds": null,
      "unavailable_when": "never",
      "cold_start": "0 (ZERO)",
      "description": "Sample standard deviation of amounts.",
      "datatype": "float64",
      "unit": "currency",
      "direction": "any",
      "cap": null,
      "leakage_risk": "low",
      "group": "transactional"
    },
    {
      "id": "F09",
      "name": "inbound_outbound_ratio",
      "definition": "min(incoming_amount / max(outgoing_amount, ε), 1e6); 0 if incoming_amount = 0",
      "window": "lifetime",
      "window_seconds": null,
      "unavailable_when": "never",
      "cold_start": "0 (ZERO)",
      "description": "Ratio of received to sent amount.",
      "datatype": "float64",
      "unit": "ratio",
      "direction": "any",
      "cap": 1000000.0,
      "leakage_risk": "low",
      "group": "transactional"
    },
    {
      "id": "F10",
      "name": "transaction_type_entropy",
      "definition": "−Σ p(type) log2 p(type) over any-direction transactions",
      "window": "lifetime",
      "window_seconds": null,
      "unavailable_when": "never",
      "cold_start": "0 (ZERO)",
      "description": "Shannon entropy of transaction types.",
      "datatype": "float64",
      "unit": "bits",
      "direction": "any",
      "cap": null,
      "leakage_risk": "medium: PaySim fraud occurs only in TRANSFER/CASH_OUT, type mix is predictive by design",
      "group": "transactional"
    },
    {
      "id": "F11",
      "name": "degree",
      "definition": "§8.3, from the snapshot used",
      "window": "snapshot",
      "window_seconds": null,
      "unavailable_when": "no usable snapshot",
      "cold_start": "UNAVAILABLE",
      "description": "Unique adjacent accounts (undirected).",
      "datatype": "int64",
      "unit": "count",
      "direction": "any",
      "cap": null,
      "leakage_risk": "low",
      "group": "graph"
    },
    {
      "id": "F12",
      "name": "in_degree",
      "definition": "§8.3",
      "window": "snapshot",
      "window_seconds": null,
      "unavailable_when": "no usable snapshot",
      "cold_start": "UNAVAILABLE",
      "description": "Unique incoming counterparties.",
      "datatype": "int64",
      "unit": "count",
