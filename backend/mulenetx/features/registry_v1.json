      "window_seconds": 1209600,
      "unavailable_when": "never",
      "cold_start": "0 (ZERO)",
      "description": "Relative change of 7-day volume.",
      "datatype": "float64",
      "unit": "ratio",
      "direction": "any",
      "cap": 10.0,
      "leakage_risk": "low",
