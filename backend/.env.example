MULENETX_API_KEY=replace-with-a-local-api-key
MULENETX_SECRET=replace-with-a-local-secret

DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/mulenetx

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Used only by the optional local copilot/embedding modules.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
